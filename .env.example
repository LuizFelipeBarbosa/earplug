# EarPlug backend environment. Copy to `.env.local` and fill in.
#
# CLIENT configuration does NOT live here — it lives in `config/dev.json` and
# `config/prod.json`, which web, iOS and Android all read via
# `--dart-define-from-file`. See docs/environments.md.
#
# ── The one rule ────────────────────────────────────────────────────────────
# A Convex deployment and a Clerk instance are chosen TOGETHER, never
# independently. Each deployment trusts exactly one Clerk issuer, so a client
# holding the other instance's key signs in successfully and then reads
# nothing — which looks like deleted data, not like misconfiguration.
#
#   development  ->  brilliant-cardinal-773  +  premium-sheep-24.clerk.accounts.dev
#   production   ->  decisive-iguana-759     +  clerk.earplug.dev
#
# The client refuses to start on a mismatched pair — `Env.configurationError`
# in lib/env.dart. `decisive-iguana-759` is named there as production; if it
# ever changes, change it there too or the guard checks the wrong name.

# ── Convex CLI ──────────────────────────────────────────────────────────────
# Written by `npx convex dev`. Selects which deployment CLI commands target.
# Prod is never selected here — reach it explicitly with `--prod`.
CONVEX_DEPLOYMENT=dev:brilliant-cardinal-773
CONVEX_URL=https://brilliant-cardinal-773.convex.cloud
CONVEX_SITE_URL=https://brilliant-cardinal-773.convex.site

# ── Convex deployment env (set with `npx convex env set`, NOT read from here) ─
# CLERK_JWT_ISSUER_DOMAIN  the ONLY thing that decides which Clerk instance a
#                          deployment trusts; read by convex/auth.config.ts.
#                          dev  -> https://premium-sheep-24.clerk.accounts.dev
#                          prod -> https://clerk.earplug.dev
# CLERK_SECRET_KEY         present on both deployments; no function reads it.

# ── Clerk backend tooling only; no client code reads this ───────────────────
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
