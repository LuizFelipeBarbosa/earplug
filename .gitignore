#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Secrets & local env
.env.local
.env*.local
dart_defines.json

# Node / Convex
node_modules/

# Convex backups
backups/

# Convex agent skills — installed by `npx convex ai-files install` and written
# byte-identically into both directories, so committing them would store the
# same ~132KB twice. Regenerable; keep both copies out of the tree. (The
# clerk-* siblings are committed once under .agents/ and symlinked from
# .claude/, which is why they are not listed here.)
.agents/skills/convex*/
.claude/skills/convex*/
